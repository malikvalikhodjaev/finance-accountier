<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#39393D</item>
        <item name="android:colorControlNormal">#6E6E73</item>
        <item name="android:windowBackground">#F5F5F7</item>
        <item name="android:statusBarColor">#F5F5F7</item>
        <item name="android:navigationBarColor">#F5F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="IncomeCalendarTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#39393D</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:datePickerStyle">@style/IncomeCalendarWidget</item>
    </style>
    <style name="IncomeCalendarWidget" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">calendar</item>
    </style>
</resources>
